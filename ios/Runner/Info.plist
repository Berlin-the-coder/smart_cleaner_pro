<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Smart Cleaner Pro</string>
    <key>CFBundleName</key>
    <string>smart_cleaner_pro</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- Required for Image Compressor / File Manager photo access -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Smart Cleaner Pro needs access to your photos to compress images and help you manage storage. Photos are never uploaded anywhere.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Smart Cleaner Pro saves compressed copies of your photos back to your photo library.</string>

    <!--
      NOTE: iOS sandboxes each app's filesystem — there is no equivalent
      of Android's full-device Junk Cleaner / App Manager / duplicate
      device-wide scan. On iOS, scope these features to the app's own
      Documents/Caches directories and the user's Photo Library only.
      Do not attempt to read other apps' storage or list installed apps;
      Apple will reject the build (Guideline 2.5.1).
    -->

    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-3940256099942544~1458002511</string>

    <key>SKAdNetworkItems</key>
    <array>
        <dict>
            <key>SKAdNetworkIdentifier</key>
            <string>cstr6suwn9.skadnetwork</string>
        </dict>
    </array>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
    </dict>
</dict>
</plist>
